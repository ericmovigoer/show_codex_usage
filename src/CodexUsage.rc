#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>
#include <commctrl.h>

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDI_APP_ICON ICON "res\\CodexUsage.ico"

IDD_MAIN DIALOGEX 0, 0, 315, 172
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Codex 用量查看器"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    GROUPBOX "5 小时额度", IDC_FIVE_GROUP, 5, 4, 150, 56
    LTEXT "剩余：暂无数据", IDC_FIVE_REMAINING, 10, 15, 140, 16
    CONTROL "", IDC_FIVE_PROGRESS, "msctls_progress32", WS_BORDER, 10, 31, 140, 7
    LTEXT "下次恢复：未提供", IDC_FIVE_RESET, 10, 39, 140, 17
    GROUPBOX "每周额度", IDC_WEEK_GROUP, 160, 4, 150, 56
    LTEXT "剩余：暂无数据", IDC_WEEK_REMAINING, 165, 15, 140, 16
    CONTROL "", IDC_WEEK_PROGRESS, "msctls_progress32", WS_BORDER, 165, 31, 140, 7
    LTEXT "下次恢复：未提供", IDC_WEEK_RESET, 165, 39, 140, 17
    LTEXT "可用重置次数：暂无数据", IDC_RESET_COUNT, 5, 62, 305, 11
    LTEXT "重置明细：暂无数据", IDC_DETAILS_TIME, 5, 74, 305, 11
    CONTROL "", IDC_DETAILS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 5, 86, 305, 50
    LTEXT "刷新间隔（秒）", IDC_INTERVAL_LABEL, 5, 143, 76, 12
    EDITTEXT IDC_INTERVAL, 82, 139, 36, 19, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "应用", IDC_APPLY, 122, 139, 40, 19
    PUSHBUTTON "立即刷新", IDC_REFRESH, 166, 139, 53, 19
    PUSHBUTTON "设置", IDC_SETTINGS, 223, 139, 40, 19
    LTEXT "正在连接…", IDC_STATUS, 5, 159, 305, 11
END

IDD_SETTINGS DIALOGEX 0, 0, 210, 88
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "字体设置"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    LTEXT "5 小时额度字体大小（磅）", -1, 8, 12, 130, 12
    EDITTEXT IDC_FIVE_FONT_SIZE, 145, 8, 50, 19, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    LTEXT "每周额度字体大小（磅）", -1, 8, 36, 130, 12
    EDITTEXT IDC_WEEK_FONT_SIZE, 145, 32, 50, 19, ES_AUTOHSCROLL | ES_NUMBER | WS_TABSTOP
    DEFPUSHBUTTON "确定", IDOK, 100, 60, 45, 20
    PUSHBUTTON "取消", IDCANCEL, 150, 60, 45, 20
END
