#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>
#include <commctrl.h>

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDI_APP_ICON ICON "res\\CodexUsage.ico"

IDD_MAIN DIALOGEX 0, 0, 420, 232
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Codex 用量查看器"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x86
BEGIN
    GROUPBOX "5 小时额度", IDC_FIVE_GROUP, 8, 6, 198, 64
    LTEXT "剩余：暂无数据", IDC_FIVE_REMAINING, 16, 19, 182, 12
    CONTROL "", IDC_FIVE_PROGRESS, "msctls_progress32", WS_BORDER, 16, 34, 182, 8
    LTEXT "下次恢复：未提供", IDC_FIVE_RESET, 16, 48, 182, 14
    GROUPBOX "每周额度", IDC_WEEK_GROUP, 214, 6, 198, 64
    LTEXT "剩余：暂无数据", IDC_WEEK_REMAINING, 222, 19, 182, 12
    CONTROL "", IDC_WEEK_PROGRESS, "msctls_progress32", WS_BORDER, 222, 34, 182, 8
    LTEXT "下次恢复：未提供", IDC_WEEK_RESET, 222, 48, 182, 14
    LTEXT "可用重置次数：暂无数据", IDC_RESET_COUNT, 8, 76, 404, 13
    LTEXT "重置明细：暂无数据", IDC_DETAILS_TIME, 8, 93, 404, 13
    CONTROL "", IDC_DETAILS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_TABSTOP | WS_BORDER, 8, 109, 404, 48
    LTEXT "刷新间隔（秒）", IDC_INTERVAL_LABEL, 8, 167, 80, 13
    EDITTEXT IDC_INTERVAL, 90, 163, 40, 20, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "应用", IDC_APPLY, 136, 163, 44, 20
    PUSHBUTTON "立即刷新", IDC_REFRESH, 186, 163, 62, 20
    LTEXT "只读查询 · 沿用本机 Codex 登录状态", IDC_READONLY, 8, 186, 404, 12
    LTEXT "正在连接…", IDC_STATUS, 8, 201, 404, 12
    LTEXT "最后成功更新：暂无数据", IDC_LAST_SUCCESS, 8, 216, 404, 12
END
